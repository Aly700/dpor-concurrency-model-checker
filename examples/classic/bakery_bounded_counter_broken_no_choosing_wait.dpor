# Algorithm: broken simplified two-thread bakery.
# Property: the plain critical-section counter touch exposes failed exclusion.
# Expected verdict: race.
# Bug: each thread skips the wait for the other thread's choosing flag. This
# bounded witness performs one ticket check, so it can observe number[j] == 0
# while the other ticket is being published.
thread:
  set r7 1
  atomic_store choosing0 1
  atomic_rmw next_ticket 1 -> r2
  bnz r2 p0_ticket_two
  atomic_store number0 1
  atomic_store choosing0 0
  read counter -> r3
  write counter 1
  atomic_store number0 0
  bnz r7 p0_done
p0_ticket_two:
  atomic_store number0 2
  atomic_store choosing0 0
  atomic_load number1 -> r1
  bnz r1 p0_abort
  read counter -> r3
  write counter 1
  atomic_store number0 0
  bnz r7 p0_done
p0_abort:
  atomic_store number0 0
p0_done:
thread:
  set r7 1
  atomic_store choosing1 1
  atomic_rmw next_ticket 1 -> r2
  bnz r2 p1_ticket_two
  atomic_store number1 1
  atomic_store choosing1 0
  read counter -> r3
  write counter 2
  atomic_store number1 0
  bnz r7 p1_done
p1_ticket_two:
  atomic_store number1 2
  atomic_store choosing1 0
  atomic_load number0 -> r1
  bnz r1 p1_abort
  read counter -> r3
  write counter 2
  atomic_store number1 0
  bnz r7 p1_done
p1_abort:
  atomic_store number1 0
p1_done:
