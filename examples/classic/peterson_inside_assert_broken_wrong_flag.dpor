# Algorithm: broken Peterson assertion variant.
# Property: a plain inside_free cell is asserted nonzero on entry.
# Expected verdict: race.
# Bug: both contenders read an unused flag cell, so the plain inside cell is
# accessed concurrently before every violating schedule necessarily reaches
# the assertion.
thread:
  write inside_free 1
  spawn 1
  spawn 2
  join 1
  join 2
thread:
  set r7 1
  atomic_store flag0 1
  atomic_store turn 1
p0_spin:
  atomic_load flag_unused -> r0
  bnz r0 p0_check_turn
  bnz r7 p0_enter
p0_check_turn:
  cas turn 1 1 -> r1
  bnz r1 p0_spin
p0_enter:
  read inside_free -> r2
  assert r2
  write inside_free 0
  write inside_free 1
  atomic_store flag0 0
thread:
  set r7 1
  atomic_store flag1 1
  atomic_store turn 0
p1_spin:
  atomic_load flag_unused -> r0
  bnz r0 p1_check_turn
  bnz r7 p1_enter
p1_check_turn:
  cas turn 0 0 -> r1
  bnz r1 p1_spin
p1_enter:
  read inside_free -> r2
  assert r2
  write inside_free 0
  write inside_free 1
  atomic_store flag1 0
