# Algorithm: Dekker's two-thread mutual exclusion.
# Property: the plain critical-section counter touch has no data race.
# Expected verdict: nontermination (with no race or assertion).
# Note: no-op CAS on turn is used as an equality test.
thread:
  set r7 1
  atomic_store flag0 1
p0_outer:
  atomic_load flag1 -> r0
  bnz r0 p0_check_turn
  bnz r7 p0_enter
p0_check_turn:
  cas turn 1 1 -> r1
  bnz r1 p0_backoff
  bnz r7 p0_outer
p0_backoff:
  atomic_store flag0 0
p0_wait_turn:
  cas turn 1 1 -> r1
  bnz r1 p0_wait_turn
  atomic_store flag0 1
  bnz r7 p0_outer
p0_enter:
  read counter -> r2
  write counter 1
  atomic_store turn 1
  atomic_store flag0 0
thread:
  set r7 1
  atomic_store flag1 1
p1_outer:
  atomic_load flag0 -> r0
  bnz r0 p1_check_turn
  bnz r7 p1_enter
p1_check_turn:
  cas turn 0 0 -> r1
  bnz r1 p1_backoff
  bnz r7 p1_outer
p1_backoff:
  atomic_store flag1 0
p1_wait_turn:
  cas turn 0 0 -> r1
  bnz r1 p1_wait_turn
  atomic_store flag1 1
  bnz r7 p1_outer
p1_enter:
  read counter -> r2
  write counter 2
  atomic_store turn 0
  atomic_store flag1 0
