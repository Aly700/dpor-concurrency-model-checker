# Three workers publish disjoint phase-one shards. The first barrier makes all
# three publications visible to every phase-two read; the second wait reuses
# the same cyclic barrier in the next generation.
thread:
  write shard0 10
  barrier_wait phase 3
  read shard1 -> r0
  barrier_wait phase 3

thread:
  write shard1 20
  barrier_wait phase 3
  read shard2 -> r0
  barrier_wait phase 3

thread:
  write shard2 30
  barrier_wait phase 3
  read shard0 -> r0
  barrier_wait phase 3
