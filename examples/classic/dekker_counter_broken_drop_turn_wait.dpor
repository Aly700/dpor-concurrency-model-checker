# Algorithm: broken Dekker variant.
# Property: the plain critical-section counter touch exposes failed exclusion.
# Expected verdict: race.
# Bug: a thread that should lower its flag and wait for turn instead immediately
# re-raises the flag and enters the critical section.
thread:
  set r7 1
  atomic_store flag0 1
p0_outer:
  atomic_load flag1 -> r0
  bnz r0 p0_check_turn
  bnz r7 p0_enter
p0_check_turn:
  cas turn 1 1 -> r1
  bnz r1 p0_backoff
  bnz r7 p0_outer
p0_backoff:
  atomic_store flag0 0
  atomic_store flag0 1
  bnz r7 p0_enter
p0_enter:
  read counter -> r2
  write counter 1
  atomic_store turn 1
  atomic_store flag0 0
thread:
  set r7 1
  atomic_store flag1 1
p1_outer:
  atomic_load flag0 -> r0
  bnz r0 p1_check_turn
  bnz r7 p1_enter
p1_check_turn:
  cas turn 0 0 -> r1
  bnz r1 p1_backoff
  bnz r7 p1_outer
p1_backoff:
  atomic_store flag1 0
  atomic_store flag1 1
  bnz r7 p1_enter
p1_enter:
  read counter -> r2
  write counter 2
  atomic_store turn 0
  atomic_store flag1 0
