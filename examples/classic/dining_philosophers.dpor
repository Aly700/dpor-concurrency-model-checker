# Forks are acquired in the total order fork0 < fork1 < fork2. The last
# philosopher reverses its left/right acquisition order to break the cycle.
thread:
  lock fork0
  lock fork1
  unlock fork1
  unlock fork0
thread:
  lock fork1
  lock fork2
  unlock fork2
  unlock fork1
thread:
  lock fork0
  lock fork2
  unlock fork2
  unlock fork0
