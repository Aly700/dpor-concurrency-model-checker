# Algorithm: broken Peterson variant.
# Property: the plain critical-section counter touch exposes failed exclusion.
# Expected verdict: race.
# Bug: both threads read an unused flag cell, so neither waits for the other.
thread:
  set r7 1
  atomic_store flag0 1
  atomic_store turn 1
p0_spin:
  atomic_load flag_unused -> r0
  bnz r0 p0_check_turn
  bnz r7 p0_enter
p0_check_turn:
  cas turn 1 1 -> r1
  bnz r1 p0_spin
p0_enter:
  read counter -> r2
  write counter 1
  atomic_store flag0 0
thread:
  set r7 1
  atomic_store flag1 1
  atomic_store turn 0
p1_spin:
  atomic_load flag_unused -> r0
  bnz r0 p1_check_turn
  bnz r7 p1_enter
p1_check_turn:
  cas turn 0 0 -> r1
  bnz r1 p1_spin
p1_enter:
  read counter -> r2
  write counter 2
  atomic_store flag1 0
