# Message passing with plain data followed by a plain publication flag.
# The assertion is reachable only under PSO, where flag may flush before data.
thread:
  write data 1
  write flag 1

thread:
  read flag -> r0
  bnz r0 saw_flag
  set r7 1
  bnz r7 done
saw_flag:
  read data -> r1
  assert r1
done:
